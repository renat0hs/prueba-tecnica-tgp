# Copia este archivo a .env y completa los valores. El .env nunca se sube a git.

# --- PostgreSQL (los usa la imagen oficial de Postgres en docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=leads

# Cadena de conexión que usan la API y el worker.
# En docker compose el host es "db" (el nombre del servicio); fuera de docker, "localhost".
DATABASE_URL=postgresql+psycopg://postgres:cambia_esto@db:5432/leads

# --- LLM (Groq, API compatible con OpenAI) ---
# Tu llave de console.groq.com. Déjala vacía aquí.
GROQ_API_KEY=
# Modelo a usar
GROQ_MODEL=openai/gpt-oss-20b
# Segundos máximos de espera por respuesta del LLM
LLM_TIMEOUT_SECONDS=20

# --- Worker ---
# Cada cuántos segundos el worker busca leads pendientes
WORKER_POLL_SECONDS=5
